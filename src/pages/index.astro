---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { formatDate } from "../utils/locale";

const [{ entries: posts, cacheHint }, settings, categoriesResult] = await Promise.all([
	getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: 11 }),
	getSiteSettings(),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: true }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(categoriesResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const categories = categoriesResult.data;
const newsPosts = posts.slice(0, 3);
const recommended = posts.filter((post) => post.data.featured_image).slice(0, 3);
const articlePosts = posts.slice(0, 10);
const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"category",
);
const primaryCategory = (id: string) => categoriesByEntry.get(id)?.[0];
---

<Base title={siteTitle} description={siteTagline} image="/chemistry-hero.png">
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__image" aria-hidden="true"></div>
		<div class="container hero__inner">
			<div class="hero__copy">
				<p class="hero__eyebrow">Chemistry, Set Up.</p>
				<h1 id="hero-title">化学は、<br />順序でわかる。</h1>
				<p>大学受験化学を、基礎から一つずつ。</p>
				<a class="btn hero__cta" href="#articles">学び始める</a>
			</div>
		</div>
	</section>

	<section class="news section-rule" aria-labelledby="news-title">
		<div class="container news__grid">
			<div class="section-label">
				<p>News</p><h2 id="news-title">お知らせ</h2><span></span>
			</div>
			<div class="news__content">
				<ul class="news__list">
					{newsPosts.map((post) => {
						const category = primaryCategory(post.data.id);
						return <li><a href={`/posts/${post.id}`}>
							<time datetime={post.data.publishedAt?.toISOString()}>{post.data.publishedAt ? formatDate(post.data.publishedAt, "short") : "更新"}</time>
							<span class="category-label">{category?.label ?? "お知らせ"}</span>
							<strong>{post.data.title}</strong>
						</a></li>;
					})}
				</ul>
				<a class="text-link" href="/posts">お知らせ一覧 <span aria-hidden="true">→</span></a>
			</div>
		</div>
	</section>

	{recommended.length > 0 && <section class="pickup section-rule" aria-labelledby="pickup-title">
		<div class="container">
			<header class="section-heading"><p>Pick Up</p><h2 id="pickup-title">おすすめ記事</h2></header>
			<div class="pickup__grid">
				{recommended.map((post) => {
					const category = primaryCategory(post.data.id);
					return <article class="pickup-card">
						<a class="pickup-card__image" href={`/posts/${post.id}`} tabindex="-1">
							<div {...post.edit.featured_image}><Image image={post.data.featured_image!} sizes="(min-width: 900px) 33vw, 100vw" /></div>
						</a>
						<div class="pickup-card__body">
							{category && <a class="category-label" href={`/category/${category.slug}`}>{category.label}</a>}
							<h3><a href={`/posts/${post.id}`}>{post.data.title}</a></h3>
							{post.data.excerpt && <p>{post.data.excerpt}</p>}
							{post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, "short")}</time>}
						</div>
					</article>;
				})}
			</div>
		</div>
	</section>}

	<section class="content-section section-rule" id="articles" aria-labelledby="articles-title">
		<div class="container content-layout">
			<div class="articles">
				<header class="section-heading"><p>Articles</p><h2 id="articles-title">記事一覧</h2></header>
				<div class="article-list">
					{articlePosts.map((post) => {
						const category = primaryCategory(post.data.id);
						return <article class="article-row">
							<a class="article-row__image" href={`/posts/${post.id}`} tabindex="-1">
								{post.data.featured_image ? <div {...post.edit.featured_image}><Image image={post.data.featured_image} sizes="180px" /></div> : <span aria-hidden="true">C</span>}
							</a>
							<div><h3><a href={`/posts/${post.id}`}>{post.data.title}</a></h3><p class="article-row__meta">
								{category && <a class="category-label" href={`/category/${category.slug}`}>{category.label}</a>}
								{post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, "short")}</time>}
							</p></div>
						</article>;
					})}
				</div>
				<a class="btn articles__button" href="/posts">記事一覧へ</a>
			</div>

			<aside class="home-sidebar" aria-label="サイドバー">
				<section><h2>キーワード検索</h2><form class="sidebar-search" action="/search"><label class="sr-only" for="sidebar-q">キーワード</label><input id="sidebar-q" name="q" type="search" placeholder="例：平衡、酸化還元、ベンゼン" /><button type="submit" aria-label="検索"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg></button></form></section>
				<section class="sidebar-promo"><p class="eyebrow">Free Material</p><h2>受験化学の<br />プレミアム学習ノート</h2><p>頻出事項の要点整理と演習問題を、一冊にまとめました。</p><a class="btn" href="/pages/about">無料教材を見る</a></section>
				<section><h2>カテゴリー</h2><ul class="category-list">{categories.map((category) => <li><a href={`/category/${category.slug}`}><span>{category.label}</span><span aria-hidden="true">›</span></a></li>)}</ul></section>
				<section><h2>最新記事</h2><div class="recent-list">{newsPosts.map((post) => <a href={`/posts/${post.id}`}>
					{post.data.featured_image && <div><Image image={post.data.featured_image} sizes="96px" /></div>}
					<span><strong>{post.data.title}</strong>{post.data.publishedAt && <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, "short")}</time>}</span>
				</a>)}</div></section>
				<section><h2>サイト運営者</h2><div class="operator"><div class="operator__portrait" aria-hidden="true">C</div><div><strong>受験化学 Set Up 編集部</strong><p>化学を「つながり」で理解できるよう、基礎から入試レベルまで丁寧に解説します。</p></div></div></section>
			</aside>
		</div>
	</section>
</Base>

<style>
	.hero{position:relative;min-height:clamp(560px,72vh,760px);isolation:isolate;display:grid;align-items:end;background:#102a43;overflow:hidden}.hero__image{position:absolute;inset:0;z-index:-2;background:url('/chemistry-hero.png') center/cover no-repeat;transform:scale(1.015)}.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(7,28,47,.96) 0%,rgba(7,28,47,.78) 34%,rgba(7,28,47,.16) 62%,rgba(7,28,47,.04) 100%)}.hero__inner{padding-block:100px 86px}.hero__copy{max-width:670px;color:#fff}.hero__eyebrow{margin:0 0 18px;padding-left:16px;border-left:5px solid var(--orange);font-family:var(--font-mono);font-size:.82rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.hero h1{margin:0;font-size:clamp(3.2rem,6vw,6.4rem);line-height:1.06;letter-spacing:-.055em}.hero__copy>p:not(.hero__eyebrow){margin:25px 0 30px;font-size:clamp(1.05rem,2vw,1.42rem)}.hero__cta{min-width:180px}
	.section-rule{border-top:1px solid var(--line);padding-block:72px}.news__grid{display:grid;grid-template-columns:270px minmax(0,1fr);gap:48px}.section-label{padding-right:42px;border-right:1px solid var(--line)}.section-label p,.section-heading p{margin:0;color:var(--ink);font-family:var(--font-mono);font-size:clamp(2rem,4vw,3.7rem);font-weight:800;line-height:1;text-transform:uppercase}.section-label h2,.section-heading h2{margin:10px 0 0;font-size:clamp(1.35rem,2.2vw,2rem)}.section-label span,.section-heading::after{display:block;width:80px;height:5px;margin-top:22px;background:var(--orange);content:""}.news__list{margin:0;padding:0;list-style:none}.news__list li{border-bottom:1px solid var(--line)}.news__list a{display:grid;grid-template-columns:140px 110px minmax(0,1fr);align-items:center;gap:18px;padding:21px 0;text-decoration:none}.news__list time{font-family:var(--font-mono);font-weight:700}.news__list strong{font-size:1.02rem}.category-label{display:inline-flex;width:max-content;padding:4px 10px;background:var(--teal);color:#fff;font-size:.74rem;font-weight:700;text-decoration:none}.text-link{display:block;width:max-content;margin:24px 0 0 auto;color:var(--teal);font-weight:800;text-underline-offset:5px}
	.section-heading{display:flex;align-items:baseline;gap:24px;margin-bottom:38px;border-bottom:1px solid var(--ink);padding-bottom:22px;position:relative}.section-heading::after{position:absolute;bottom:-3px;left:0;margin:0}.pickup__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.pickup-card{background:var(--white);border-bottom:1px solid var(--line)}.pickup-card__image{display:block;aspect-ratio:4/3;overflow:hidden}.pickup-card__image div{height:100%}.pickup-card__image :global(img){width:100%;height:100%;object-fit:cover;transition:transform .45s cubic-bezier(.16,1,.3,1)}.pickup-card:hover .pickup-card__image :global(img){transform:scale(1.025)}.pickup-card__body{padding:20px 20px 22px}.pickup-card h3{margin:14px 0 8px;font-size:1.25rem;line-height:1.45}.pickup-card h3 a{text-decoration:none}.pickup-card p{margin:0 0 16px;color:var(--muted);font-size:.88rem}.pickup-card time{font-family:var(--font-mono);font-size:.78rem;color:var(--muted)}
	.content-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:58px;align-items:start}.article-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:30px}.article-row{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}.article-row__image{display:grid;place-items:center;aspect-ratio:16/10;overflow:hidden;background:#e9eeec;color:var(--teal);font-size:2rem;font-weight:900;text-decoration:none}.article-row__image>div{width:100%;height:100%}.article-row__image :global(img){width:100%;height:100%;object-fit:cover}.article-row h3{margin:0 0 12px;font-size:1rem;line-height:1.45}.article-row h3 a{text-decoration:none}.article-row__meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0}.article-row time{font-family:var(--font-mono);font-size:.72rem;color:var(--muted)}.articles__button{display:flex;width:max-content;min-width:240px;margin:34px auto 0}
	.home-sidebar{padding-left:30px;border-left:1px solid var(--teal)}.home-sidebar>section{padding:0 0 28px;margin-bottom:28px;border-bottom:1px solid var(--line)}.home-sidebar h2{margin:0 0 14px;padding-left:14px;border-left:5px solid var(--teal);font-size:1.05rem}.sidebar-search{display:grid;grid-template-columns:minmax(0,1fr) 46px}.sidebar-search input{min-width:0;height:46px;padding:0 12px;border:1px solid var(--line);background:#fff}.sidebar-search button{display:grid;place-items:center;border:0;background:var(--teal);color:#fff}.sidebar-search svg{width:21px;fill:none;stroke:currentColor;stroke-width:2}.sidebar-promo{padding:25px!important;background:#fff}.sidebar-promo h2{padding:0;border:0;font-size:1.4rem}.sidebar-promo p{font-size:.85rem}.sidebar-promo .btn{width:100%;padding-inline:12px}.category-list{margin:0;padding:0;list-style:none}.category-list li{border-top:1px solid var(--line)}.category-list a{display:flex;justify-content:space-between;padding:8px 4px;text-decoration:none}.recent-list>a{display:grid;grid-template-columns:86px minmax(0,1fr);gap:12px;padding:12px 0;border-top:1px solid var(--line);text-decoration:none}.recent-list>a>div{aspect-ratio:16/10;overflow:hidden}.recent-list :global(img){width:100%;height:100%;object-fit:cover}.recent-list strong{display:block;font-size:.8rem;line-height:1.4}.recent-list time{display:block;margin-top:4px;color:var(--muted);font-family:var(--font-mono);font-size:.68rem}.operator{display:grid;grid-template-columns:74px minmax(0,1fr);gap:15px}.operator__portrait{display:grid;place-items:center;width:74px;height:74px;border-radius:50%;background:var(--ink);color:#fff;font-size:1.8rem;font-weight:900}.operator p{margin:5px 0 0;color:var(--muted);font-size:.78rem}
	@media(max-width:1000px){.content-layout{grid-template-columns:minmax(0,1fr) 280px;gap:35px}.article-list{grid-template-columns:1fr}.pickup__grid{gap:12px}.news__grid{grid-template-columns:220px minmax(0,1fr)}}
	@media(max-width:800px){.hero{min-height:620px}.hero__image{background-position:65% center}.hero::after{background:linear-gradient(90deg,rgba(7,28,47,.94),rgba(7,28,47,.65))}.news__grid,.content-layout{grid-template-columns:1fr}.section-label{padding:0 0 24px;border-right:0;border-bottom:1px solid var(--line)}.pickup__grid{grid-template-columns:1fr}.pickup-card{display:grid;grid-template-columns:42% minmax(0,1fr)}.pickup-card__image{height:100%}.home-sidebar{padding-left:0;border-left:0;border-top:1px solid var(--teal);padding-top:38px}.news__list a{grid-template-columns:110px minmax(0,1fr)}.news__list strong{grid-column:1/-1}.article-list{grid-template-columns:repeat(2,minmax(0,1fr))}}
	@media(max-width:560px){.hero{min-height:560px}.hero__inner{padding-block:80px 55px}.hero h1{font-size:3.1rem}.section-rule{padding-block:48px}.news__list a{grid-template-columns:1fr auto;gap:8px}.news__list strong{font-size:.92rem}.section-heading{align-items:flex-start;flex-direction:column;gap:6px}.pickup-card{display:block}.article-list{grid-template-columns:1fr}.article-row{grid-template-columns:112px minmax(0,1fr)}.content-layout{gap:48px}}
</style>
