---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd, WidgetArea } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props { title: string; pageTitle?: string | null; description?: string | null; image?: string | null; canonical?: string | null; robots?: string | null; type?: "website" | "article"; publishedTime?: string | null; modifiedTime?: string | null; author?: string | null; content?: { collection: string; id: string; slug?: string | null }; }
const { title, pageTitle, description, image, canonical, robots, type = "website", publishedTime, modifiedTime, author, content } = Astro.props;
const [settingsResult, menuResult] = await Promise.all([getSiteSettingsWithCacheHint(), getMenuWithCacheHint("primary")]);
if (Astro.cache?.enabled) { Astro.cache.set(settingsResult.cacheHint); Astro.cache.set(menuResult.cacheHint); }
const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(settingsResult.data);
const fullTitle = title === siteTitle || title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const menuItems = menuResult.data?.items ?? [];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pageCtx = createPublicPageContext({ Astro, kind: content ? "content" : "custom", pageType: type, title: fullTitle, pageTitle: pageTitle ?? title, description, canonical, image, content, seo: { ogImage: image, robots }, articleMeta: { publishedTime, modifiedTime, author }, siteName: siteTitle });
const isLoggedIn = !!Astro.locals.user;
const year = new Date().getFullYear();
function navCurrent(url: string) { try { const path = new URL(url, Astro.url).pathname.replace(/\/$/, "") || "/"; return path === currentPath ? "page" : path !== "/" && currentPath.startsWith(`${path}/`) ? "true" : undefined; } catch { return undefined; } }
---
<!doctype html>
<html lang="ja">
<head>
	<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<Font cssVariable="--font-body" preload /><Font cssVariable="--font-mono" />
	<title>{fullTitle}</title>{description && <meta name="description" content={description} />}
	<EmDashHead page={pageCtx} /><link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
</head>
<body>
	<EmDashBodyStart page={pageCtx} /><a href="#main" class="skip-link">本文へ移動</a>
	<header class="site-header"><div class="container header-inner">
		<a class="brand-logo" href="/" aria-label={`${siteTitle} ホーム`}>{siteLogo ? <img class="brand-image" src={siteLogo.url} alt={siteLogo.alt || siteTitle} /> : <span class="brand-mark" aria-hidden="true">C</span>}<span>{siteTitle}</span></a>
		<nav class="nav" id="main-navigation" aria-label="メインナビゲーション">
			{menuItems.map((item) => <a href={item.url} target={item.target} rel={item.target === "_blank" ? "noopener noreferrer" : undefined} aria-current={navCurrent(item.url)}>{item.label}</a>)}
			<div class="header-search"><LiveSearch placeholder="記事を検索" collections={["posts", "pages"]} inputClass="site-search-input" resultsClass="site-search-results" resultClass="site-search-result" /></div>
			<a class="btn header-cta" href="/posts">記事一覧</a>{isLoggedIn && <a href="/_emdash/admin">管理画面</a>}
		</nav>
		<button class="menu-toggle" type="button" aria-label="メニューを開く" aria-controls="main-navigation" aria-expanded="false"><span aria-hidden="true">☰</span></button>
	</div></header>
	<main id="main" tabindex="-1"><slot /></main>
	<footer class="site-footer"><div class="container footer-grid">
		<div class="footer-brand"><a class="brand-logo" href="/">{siteLogo ? <img class="brand-image" src={siteLogo.url} alt="" /> : <span class="brand-mark" aria-hidden="true">C</span>}<span>{siteTitle}</span></a><p>{siteTagline}</p></div>
		<div class="footer-col"><h2>サイトメニュー</h2>{menuItems.map((item) => <a href={item.url}>{item.label}</a>)}</div>
		<div class="footer-col"><h2>コンテンツ</h2><a href="/posts">記事一覧</a><a href="/search">サイト内検索</a><a href="/rss.xml">RSS</a></div>
		<div class="footer-col footer-widgets"><WidgetArea name="footer" /></div>
	</div><div class="container copyright">© {year} {siteTitle}. All rights reserved.</div></footer>
	<script>
		const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle"); const nav = document.querySelector<HTMLElement>(".nav");
		toggle?.addEventListener("click", () => { const open = toggle.getAttribute("aria-expanded") === "true"; toggle.setAttribute("aria-expanded", String(!open)); toggle.setAttribute("aria-label", open ? "メニューを開く" : "メニューを閉じる"); nav?.classList.toggle("is-open", !open); document.body.classList.toggle("menu-open", !open); });
		nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => { nav.classList.remove("is-open"); document.body.classList.remove("menu-open"); toggle?.setAttribute("aria-expanded", "false"); }));
	</script>
	<EmDashBodyEnd page={pageCtx} />
</body>
</html>
